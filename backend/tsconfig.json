{
  "compilerOptions": {
    "rootDir": "..",
    "paths": {
      "@shared/*": ["../shared/*"]
    },
    "outDir": "./dist/",
    "target": "es2016",
    "module": "NodeNext",
    "strict": true,
    "lib": [ "ES2021", "dom" ],
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./**/*", "../shared/**/*"],
  "exclude": ["dist", "node_modules"]
}
